    "The same time in both means the whole day." : {
      "comment" : "Footer under the From and Until pickers of a Screen on time window.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሁለቱም አንድ አይነት ሰዓት ማለት ቀኑን ሙሉ ማለት ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقت نفسه في الحقلين يعني اليوم بأكمله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stejný čas v obou polích znamená celý den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieselbe Uhrzeit in beiden Feldern bedeutet den ganzen Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma hora en ambos significa todo el día."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama kellaaeg mõlemas tähendab tervet päeva."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietan ordu bera jartzeak egun osoa esan nahi du."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama kellonaika molemmissa tarkoittaa koko päivää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag pareho ang oras sa dalawa, ibig sabihin ay buong araw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La même heure dans les deux champs signifie toute la journée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אותה שעה בשניהם פירושה כל היום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों में एक ही समय का मतलब है पूरा दिन।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tib lub sijhawm rau ob qho txhais tau tias tag nrho hnub."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha mindkettőben ugyanaz az időpont, az egész napot jelent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stesso orario in entrambi significa tutto il giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を同じ時刻にすると終日になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 시간이 같으면 하루 종일을 의미합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas pats laikas abiejuose laukuose reiškia visą dieną."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme klokkeslett i begge betyr hele dagen."
          }
