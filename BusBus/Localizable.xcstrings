    "Go" : {
      "shouldTranslate" : false
    },
    "Got a spare iPhone in a drawer? Set up Guided Access to lock it into this app." : {
      "comment" : "Settings row under the Wall mode toggle; tapping it opens a guide to setting up Guided Access (Apple's iOS feature that locks the device into one app). Use Apple's official name for Guided Access.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በመሳቢያ ውስጥ ትርፍ iPhone አለዎት? በዚህ መተግበሪያ ላይ ለመቆለፍ የተመራ መዳረሻን (Guided Access) ያዋቅሩ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل لديك iPhone إضافي في أحد الأدراج؟ قم بإعداد الوصول الموجه لقفله على هذا التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máš v šuplíku iPhone navíc? Nastav asistovaný přístup a uzamkni ho v této aplikaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegt noch ein iPhone in der Schublade? Richte den geführten Zugriff ein, um es auf diese App zu beschränken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes un iPhone de sobra en un cajón? Configura Acceso guiado para fijarlo en esta app."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas sahtlis on üleliigne iPhone? Seadista Guided Access, et lukustada see sellesse rakendusse."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiradera batean iPhone bat soberan duzu? Konfiguratu Sarbide gidatua aplikazio honetan blokeatuta gera dadin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko laatikossa ylimääräinen iPhone? Ota Ohjattu käyttö käyttöön, niin se pysyy tässä apissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May sobrang iPhone ka sa drawer? I-set up ang Guided Access para i-lock ito sa app na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un iPhone qui traîne dans un tiroir ? Configurez Accès guidé pour le verrouiller sur cette app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לכם אייפון מיותר במגירה? הגדירו ״גישה מודרכת״ כדי לנעול אותו על האפליקציה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दराज़ में कोई फ़ालतू iPhone पड़ा है? उसे इस ऐप में लॉक करने के लिए गाइडेड ऐक्सेस सेट अप करें।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puas muaj ib lub iPhone seem nyob hauv lub tub rau khoom? Teeb Guided Access los xauv nws rau hauv app no."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van egy felesleges iPhone-od a fiókban? Állítsd be az Irányított hozzáférést, és zárold ebbe az appba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un iPhone in più in un cassetto? Configura Accesso Guidato per bloccarlo su questa app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引き出しに使っていないiPhoneはありませんか？アクセスガイドを設定すれば、このアプリから離れられないようにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서랍 속에 남는 iPhone이 있나요? 사용법 유도를 설정하면 이 앱에 고정해 둘 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stalčiuje guli nenaudojamas iPhone? Nustatykite funkciją „Ribotoji prieiga“, kad užrakintumėte jį šioje programoje."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du en ekstra iPhone i en skuff? Konfigurer Begrenset tilgang for å låse den til denne appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligt er nog een iPhone in een la? Stel begeleide toegang in om hem aan deze app vast te zetten."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du ein ekstra iPhone i ei skuff? Set opp Begrenset tilgang for å låse den til denne appen."
