    "Outside these times the screen goes black. Tap it to show the board for 20 seconds." : {
      "comment" : "Settings footer under the Screen on list when times are set.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከእነዚህ ሰዓታት ውጭ ማያው ይጠቁራል። ሰሌዳውን ለ20 ሰከንድ ለማየት ማያውን መታ ያድርጉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خارج هذه الأوقات تصبح الشاشة سوداء. اضغط عليها لعرض اللوحة لمدة 20 ثانية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimo tyto časy obrazovka zčerná. Klepnutím na ni zobrazíš tabuli na 20 sekund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb dieser Zeiten wird der Bildschirm schwarz. Tippe darauf, um die Anzeige 20 Sekunden lang zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de estos horarios, la pantalla se queda en negro. Tócala para ver el panel durante 20 segundos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljaspool neid aegu läheb ekraan mustaks. Puuduta seda, et näha tablood 20 sekundit."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordu horietatik kanpo, pantaila beltz geratzen da. Ukitu pantaila panela 20 segundoz ikusteko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näiden aikojen ulkopuolella näyttö muuttuu mustaksi. Napauta sitä, niin taulu näkyy 20 sekuntia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa labas ng mga oras na ito, nagiging itim ang screen. I-tap ito para makita ang board nang 20 segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dehors de ces horaires, l’écran devient noir. Touchez-le pour afficher le tableau pendant 20 secondes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחוץ לזמנים האלה המסך נהיה שחור. הקשה עליו מציגה את הלוח למשך 20 שניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन समयों के बाहर स्क्रीन काली हो जाती है। बोर्ड को 20 सेकंड तक देखने के लिए उस पर टैप करें।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sab nraum cov sijhawm no lub vijtsam yuav tig dub. Kov nws kom pom daim txiag tau 20 vib nas this."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeken az időszakokon kívül a képernyő elsötétül. Koppints rá, és a kijelző 20 másodpercig látható lesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuori da questi orari lo schermo diventa nero. Toccalo per vedere il tabellone per 20 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの時間帯以外は画面が黒くなります。タップすると20秒間ボードを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시간 외에는 화면이 검게 바뀝니다. 탭하면 20초 동안 보드가 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už šių laikų ribų ekranas pajuodija. Bakstelėkite jį, kad švieslentė būtų rodoma 20 sekundžių."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utenom disse tidene blir skjermen svart. Trykk på den for å vise tavlen i 20 sekunder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buiten deze tijden wordt het scherm zwart. Tik erop om het bord 20 seconden te zien."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utanom desse tidene vert skjermen svart. Trykk på han for å vise tavla i 20 sekund."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹਨਾਂ ਸਮਿਆਂ ਤੋਂ ਬਾਹਰ ਸਕਰੀਨ ਕਾਲੀ ਹੋ ਜਾਂਦੀ ਹੈ। 20 ਸਕਿੰਟਾਂ ਲਈ ਬੋਰਡ ਦੇਖਣ ਵਾਸਤੇ ਇਸ ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza tymi godzinami ekran robi się czarny. Stuknij go, aby wyświetlić tablicę przez 20 sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora desses horários, a tela fica preta. Toque nela para ver o painel por 20 segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora destes horários, o ecrã fica preto. Toque nele para ver o painel durante 20 segundos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În afara acestor intervale, ecranul devine negru. Atinge-l ca să vezi panoul timp de 20 de secunde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вне этих часов экран становится чёрным. Коснитесь его, чтобы показать табло на 20 секунд."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zunaj teh časov zaslon postane črn. Tapni ga, da se tabla prikaže za 20 sekund."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wixii ka baxsan waqtiyadan shaashaddu way madoobaanaysaa. Taabo si aad looxa u aragto 20 ilbiriqsi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utanför de här tiderna blir skärmen svart. Tryck på den för att visa tavlan i 20 sekunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu saatlerin dışında ekran siyaha döner. Panoyu 20 saniye görmek için ekrana dokun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài các khung giờ này, màn hình sẽ tối đen. Chạm vào để hiện bảng trong 20 giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这些时段之外，屏幕会变黑。轻点屏幕可显示看板 20 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這些時段以外，螢幕會變黑。輕點螢幕即可顯示看板 20 秒。"
          }
        }
      }
