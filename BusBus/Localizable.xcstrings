    "Location is turned off on this device, so the stops around you can't be listed." : {
      "comment" : "Body of the NEARBY card when location is restricted on the device (Screen Time or device management), so the rider cannot turn it on in Settings; a \"Search by name instead\" button follows it.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዚህ መሣሪያ ላይ አካባቢ ስለጠፋ በዙሪያዎ ያሉ ፌርማታዎች ሊዘረዘሩ አይችሉም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع متوقف على هذا الجهاز، لذا لا يمكن عرض المحطات من حولك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poloha je na tomto zařízení vypnutá, takže nelze zobrazit zastávky ve tvém okolí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort ist auf diesem Gerät ausgeschaltet, daher können die Haltestellen in deiner Nähe nicht aufgelistet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación está desactivada en este dispositivo, así que no se pueden mostrar las paradas a tu alrededor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asukoht on selles seadmes välja lülitatud, seega ei saa sinu ümber olevaid peatusi näidata."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokapena desaktibatuta dago gailu honetan; beraz, ezin dira inguruko geltokiak zerrendatu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijainti on poistettu käytöstä tässä laitteessa, joten ympärilläsi olevia pysäkkejä ei voi näyttää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang lokasyon sa device na ito, kaya hindi maipakita ang mga hintuan sa paligid mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La localisation est désactivée sur cet appareil, les arrêts autour de vous ne peuvent donc pas être listés."
