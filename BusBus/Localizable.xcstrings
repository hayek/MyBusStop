        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завалялся лишний iPhone в ящике? Настройте гид-доступ, чтобы закрепить его в этом приложении."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaš v predalu odvečen iPhone? Nastavi Vodeni dostop, da ga zakleneš v to aplikacijo."
