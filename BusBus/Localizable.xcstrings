          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर लोकेशन बंद है, इसलिए आपके आस-पास के स्टॉप नहीं दिखाए जा सकते।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
