    "See where each bus is on its line, and exactly how many minutes until it reaches you." : {
      "comment" : "Welcome story page 1 body.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያንዳንዱ አውቶቡስ በመስመሩ ላይ የት እንዳለ፣ እና እርስዎ ጋር ለመድረስ በትክክል ስንት ደቂቃ እንደቀረው ይመልከቱ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد مكان كل حافلة على خطها، وكم دقيقة بالضبط حتى تصل إليك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvidíš, kde je každý autobus na své lince a za kolik přesně minut bude u tebe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wo jeder Bus auf seiner Linie ist und in wie vielen Minuten genau er bei dir ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira dónde está cada autobús en su línea y cuántos minutos exactos faltan para que llegue."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata, kus iga buss oma liinil on ja täpselt mitu minutit kulub, kuni see sinuni jõuab."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikusi autobus bakoitza bere linean non dagoen, eta zehazki zenbat minutu falta zaizkion zuregana iristeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe, missä kukin bussi on linjallaan ja tarkalleen montako minuuttia sen saapumiseen on."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan kung nasaan ang bawat bus sa linya nito, at eksakto kung ilang minuto pa bago ito makarating sa iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez où se trouve chaque bus sur sa ligne, et dans combien de minutes exactement il arrive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ראו איפה כל אוטובוס נמצא על הקו שלו, ובעוד כמה דקות בדיוק הוא מגיע אליכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि हर बस अपनी लाइन पर कहाँ है, और ठीक कितने मिनट में आप तक पहुँचेगी।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saib txhua lub tsheb npav nyob qhov twg ntawm nws txoj kab, thiab tshuav pes tsawg feeb nws mam los txog koj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lásd, hol jár minden busz a vonalán, és pontosan hány perc múlva ér hozzád."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda dove si trova ogni autobus sulla sua linea e tra quanti minuti esatti arriva da te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各バスが系統上のどこにいるか、あと何分で着くかが正確にわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버스마다 노선의 어디쯤 있는지, 정확히 몇 분 뒤에 도착하는지 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matykite, kur savo maršrute yra kiekvienas autobusas ir po kiek tiksliai minučių jis pas jus atvyks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hvor hver buss er på linjen sin, og nøyaktig hvor mange minutter det er til den når deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie waar elke bus op zijn lijn is, en over precies hoeveel minuten hij bij je is."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjå kvar kvar buss er på linja si, og nøyaktig kor mange minutt det er til han når deg."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦੇਖੋ ਹਰ ਬੱਸ ਆਪਣੀ ਲਾਈਨ ਉੱਤੇ ਕਿੱਥੇ ਹੈ, ਅਤੇ ਤੁਹਾਡੇ ਤੱਕ ਪਹੁੰਚਣ ਵਿੱਚ ਠੀਕ ਕਿੰਨੇ ਮਿੰਟ ਬਾਕੀ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz, gdzie na swojej linii jest każdy autobus i za ile dokładnie minut do ciebie dotrze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja onde cada ônibus está na linha e em exatamente quantos minutos ele chega até você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja onde está cada autocarro na sua linha e daqui a quantos minutos exatamente chega até si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezi unde se află fiecare autobuz pe linia sa și în exact câte minute ajunge la tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите, где каждый автобус на своём маршруте и через сколько минут точно он до вас доедет."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poglej, kje na svoji liniji je vsak avtobus in čez koliko minut točno bo pri tebi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arag meesha bas kastaa ka joogo khadkiisa, iyo imisa daqiiqo oo sax ah ka hor inta uusan ku soo gaarin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se var varje buss är på sin linje och exakt hur många minuter det är tills den når dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her otobüsün hattında nerede olduğunu ve sana tam kaç dakikada ulaşacağını gör."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem từng xe buýt đang ở đâu trên tuyến, và chính xác còn bao nhiêu phút nữa xe đến chỗ bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看清每班车在线路上的位置，以及还要几分钟才到你这里，精确到分钟。"
