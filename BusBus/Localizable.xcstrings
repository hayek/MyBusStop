        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xogta tooska ah ee halkan waa la hakiyay hadda. Looxu iskiis ayuu u soo laaban doonaa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
