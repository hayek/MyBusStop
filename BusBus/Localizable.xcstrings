          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gammel telefon hengt på veggen ved døren, koblet til strøm, som viser busskartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een oude telefoon aan de muur bij de deur, aan de lader, met de buskaart."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gammal telefon hengd på veggen ved døra, kopla til straum, som viser busskartet."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦਰਵਾਜ਼ੇ ਕੋਲ ਕੰਧ ਉੱਤੇ ਟੰਗਿਆ ਇੱਕ ਪੁਰਾਣਾ ਫ਼ੋਨ, ਚਾਰਜਰ ਨਾਲ ਲੱਗਿਆ, ਬੱਸਾਂ ਦਾ ਨਕਸ਼ਾ ਦਿਖਾਉਂਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stary telefon powieszony na ścianie przy drzwiach, podłączony do prądu, z mapą autobusów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um celular antigo pendurado na parede perto da porta, na tomada, mostrando o mapa dos ônibus."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um telemóvel antigo pendurado na parede junto à porta, ligado à corrente, a mostrar o mapa dos autocarros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un telefon vechi agățat pe perete lângă ușă, conectat la priză, care arată harta autobuzelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старый телефон на стене у двери, на зарядке, показывает карту автобусов."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star telefon na steni ob vratih, priključen na polnilnik, prikazuje zemljevid avtobusov."
