    "Only used to find the stops around you, and only while BusBus is open." : {
      "comment" : "Body of the location permission card: how the location is used. BusBus is the app name; do not translate it.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዙሪያዎ ያሉ ፌርማታዎችን ለማግኘት ብቻ፣ እና BusBus ክፍት ሲሆን ብቻ ነው የሚውለው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم فقط للعثور على المحطات من حولك، وفقط أثناء فتح BusBus."
          }
        },
        "cs" : {
