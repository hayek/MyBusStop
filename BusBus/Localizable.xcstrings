        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma haysaa iPhone dheeraad ah oo khaanad ku jira? Deji Gelitaanka La Hagayo (Guided Access) si aad ugu xidho app-kan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du en extra iPhone i en låda? Ställ in Guidad åtkomst för att låsa den till den här appen."
          }
