    "Stops you save on your iPhone, iPad or Mac appear here through iCloud." : {
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በiPhone፣ iPad ወይም Mac ላይ የሚያስቀምጧቸው ፌርማታዎች በiCloud በኩል እዚህ ይታያሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا المحطات التي تحفظها على iPhone أو iPad أو Mac عبر iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastávky uložené na zařízeních iPhone, iPad nebo Mac se tu objeví přes iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltestellen, die du auf deinem iPhone, iPad oder Mac sicherst, erscheinen hier über iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las paradas que guardes en tu iPhone, iPad o Mac aparecen aquí a través de iCloud."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'is, iPadis või Macis salvestatud peatused ilmuvad siia iCloudi kaudu."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonean, iPadean edo Macean gordetzen dituzun geltokiak hemen agertzen dira iCloud bidez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonella, iPadilla tai Macilla tallentamasi pysäkit näkyvät täällä iCloudin kautta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalabas dito sa pamamagitan ng iCloud ang mga hintuang sine-save mo sa iyong iPhone, iPad o Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les arrêts que vous enregistrez sur votre iPhone, iPad ou Mac apparaissent ici via iCloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תחנות ששמרת ב־iPhone, ב־iPad או ב־Mac יופיעו כאן דרך iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपने iPhone, iPad या Mac पर जो स्टॉप सहेजते हैं, वे iCloud के ज़रिए यहाँ दिखते हैं।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cov chaw nres uas koj khaws rau hauv koj lub iPhone, iPad los yog Mac yuav tshwm ntawm no los ntawm iCloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPhone-on, iPaden vagy Macen mentett megállóid az iCloudon keresztül itt jelennek meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fermate che salvi su iPhone, iPad o Mac appaiono qui tramite iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone、iPad、Macで保存した停留所は、iCloudを通じてここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, iPad 또는 Mac에서 저장한 정류장이 iCloud를 통해 여기에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stotelės, kurias išsaugote iPhone, iPad ar Mac, per iCloud atsiranda čia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holdeplasser du lagrer på iPhone, iPad eller Mac, vises her via iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltes die je op je iPhone, iPad of Mac bewaart, verschijnen hier via iCloud."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haldeplassar du lagrar på iPhone, iPad eller Mac, blir viste her via iCloud."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ iPhone, iPad ਜਾਂ Mac ਉੱਤੇ ਸੰਭਾਲੇ ਸਟਾਪ iCloud ਰਾਹੀਂ ਇੱਥੇ ਦਿਖਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
