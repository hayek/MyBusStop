    "Live data here is paused for now. The board will come back by itself." : {
      "comment" : "Body of the screen shown when the region's provider has been switched off remotely.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እዚህ ያለው ቀጥታ መረጃ ለጊዜው ቆሟል። ሰሌዳው በራሱ ይመለሳል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيانات المباشرة هنا متوقفة مؤقتًا. ستعود اللوحة من تلقاء نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živá data jsou tu zatím pozastavena. Tabule se vrátí sama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Daten sind hier vorerst pausiert. Die Anzeige kommt von selbst zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos en vivo están en pausa aquí por ahora. El panel volverá por sí solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaalajas andmed on siin praegu peatatud. Tabloo tuleb ise tagasi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemengo zuzeneko datuak etenaldian daude oraingoz. Panela berez itzuliko da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaaliaikaiset tiedot ovat täällä toistaiseksi tauolla. Taulu palaa itsestään."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-pause muna ang live data dito. Kusang babalik ang board."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données en direct sont suspendues ici pour le moment. Le tableau reviendra de lui-même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנתונים בזמן אמת כאן מושהים כרגע. הלוח יחזור מעצמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ लाइव डेटा अभी रुका हुआ है। बोर्ड अपने आप वापस आ जाएगा।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cov ntaub ntawv ncaj qha ntawm no nres ib pleb. Daim txiag yuav rov los nws tus kheej."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az élő adatok itt egyelőre szünetelnek. A kijelző magától visszaáll."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati in diretta qui sono sospesi per ora. Il tabellone tornerà da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この地域のリアルタイム情報は現在一時停止中です。表示は自動的に元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지역의 실시간 정보가 잠시 중단되었습니다. 화면은 자동으로 다시 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiesioginiai duomenys čia kol kas sustabdyti. Švieslentė grįš savaime."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanntidsdata her er satt på pause inntil videre. Tavlen kommer tilbake av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livegegevens zijn hier voorlopig gepauzeerd. Het bord komt vanzelf terug."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanntidsdata her er sett på pause inntil vidare. Tavla kjem tilbake av seg sjølv."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਥੇ ਲਾਈਵ ਡਾਟਾ ਫ਼ਿਲਹਾਲ ਰੁਕਿਆ ਹੋਇਆ ਹੈ। ਬੋਰਡ ਆਪਣੇ ਆਪ ਵਾਪਸ ਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane na żywo są tu chwilowo wstrzymane. Tablica wróci sama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados ao vivo daqui estão pausados por enquanto. O painel voltará sozinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados em tempo real estão em pausa aqui, por agora. O painel voltará sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele live sunt deocamdată întrerupte aici. Panoul va reveni de la sine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
