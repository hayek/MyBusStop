    "We're working on a fix. The board will come back by itself." : {
      "comment" : "Body of the service-down screen. The board is the live bus display.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያስተካከልነው ነው። ሰሌዳው በራሱ ይመለሳል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نعمل على إصلاح المشكلة. ستعود اللوحة من تلقاء نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujeme na nápravě. Tabule se vrátí sama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir arbeiten an einer Lösung. Die Anzeige kommt von selbst zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos trabajando en una solución. El panel volverá por sí solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegeleme parandusega. Tabloo tuleb ise tagasi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konpontzen ari gara. Panela berez itzuliko da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korjaamme vikaa. Taulu palaa itsestään."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaayos na namin ito. Kusang babalik ang board."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous travaillons à une solution. Le tableau reviendra de lui-même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנחנו עובדים על תיקון. הלוח יחזור מעצמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम इसे ठीक करने पर काम कर रहे हैं। बोर्ड अपने आप वापस आ जाएगा।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peb tabtom kho. Daim txiag yuav rov los nws tus kheej."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolgozunk a javításon. A kijelző magától visszaáll."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiamo lavorando a una soluzione. Il tabellone tornerà da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在復旧に取り組んでいます。表示は自動的に元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제를 해결하고 있습니다. 화면은 자동으로 다시 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taisome gedimą. Švieslentė grįš savaime."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi jobber med en løsning. Tavlen kommer tilbake av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We werken aan een oplossing. Het bord komt vanzelf terug."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi jobbar med ei løysing. Tavla kjem tilbake av seg sjølv."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਸੀਂ ਇਸ ਨੂੰ ਠੀਕ ਕਰ ਰਹੇ ਹਾਂ। ਬੋਰਡ ਆਪਣੇ ਆਪ ਵਾਪਸ ਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujemy nad naprawą. Tablica wróci sama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos trabalhando em uma correção. O painel voltará sozinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a trabalhar numa solução. O painel voltará sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucrăm la o soluție. Panoul va reveni de la sine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы уже работаем над исправлением. Табло вернётся само."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delamo na rešitvi. Tabla se bo vrnila sama od sebe."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waan hagaajinaynaa. Looxu iskiis ayuu u soo laaban doonaa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
