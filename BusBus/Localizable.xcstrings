    "An old phone hung on the wall by the door, plugged in, showing the bus map." : {
      "comment" : "VoiceOver description of the page 2 illustration.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በበሩ አጠገብ ግድግዳ ላይ የተሰቀለ፣ ቻርጅ ላይ የተሰካ፣ የአውቶቡስ ካርታውን የሚያሳይ አሮጌ ስልክ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هاتف قديم معلّق على الحائط بجانب الباب، موصول بالشاحن، يعرض خريطة الحافلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starý telefon pověšený na zdi u dveří, zapojený do nabíječky, s mapou autobusů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein altes Handy an der Wand neben der Tür, am Strom, mit der Buskarte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un teléfono viejo colgado en la pared junto a la puerta, enchufado, mostrando el mapa de autobuses."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vana telefon seinal ukse kõrval, laadijas, näitab bussikaarti."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefono zahar bat horman, atearen ondoan, entxufatuta, autobusen mapa erakusten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanha puhelin seinällä oven vieressä laturissa, näytöllä bussikartta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isang lumang telepono na nakasabit sa pader malapit sa pinto, nakasaksak, at ipinapakita ang mapa ng bus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vieux téléphone accroché au mur près de la porte, branché, qui affiche la carte des bus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טלפון ישן תלוי על הקיר ליד הדלת, מחובר לחשמל, ומציג את מפת האוטובוסים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दरवाज़े के पास दीवार पर टँगा एक पुराना फ़ोन, चार्जर से जुड़ा, जिस पर बस का नक्शा दिख रहा है।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ib lub xov tooj qub dai ntawm phab ntsa ze qhov rooj, txuas hluav taws, qhia daim ntawv qhia tsheb npav."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy régi telefon a falon az ajtó mellett, töltőre dugva, a buszok térképével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vecchio telefono appeso al muro vicino alla porta, collegato alla corrente, che mostra la mappa degli autobus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドアのそばの壁に掛けられ、電源につながれた古いスマートフォン。バスの地図が表示されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문 옆 벽에 걸려 전원에 연결된 오래된 휴대폰. 버스 지도가 표시되어 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
