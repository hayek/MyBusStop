    "Tap the stop name any time to change its lines, or the back arrow to change the stop." : {
      "comment" : "First-board tip body: the stop name changes the lines, the back arrow before it changes the stop.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መስመሮቹን ለመቀየር በማንኛውም ጊዜ የፌርማታውን ስም፣ ፌርማታውን ለመቀየር ደግሞ የመመለሻ ቀስቱን ይንኩ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على اسم المحطة في أي وقت لتغيير خطوطها، أو على سهم الرجوع لتغيير المحطة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na název zastávky můžeš kdykoli změnit její linky, klepnutím na šipku zpět zastávku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe jederzeit auf den Haltestellennamen, um ihre Linien zu ändern, oder auf den Zurück-Pfeil, um die Haltestelle zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el nombre de la parada cuando quieras para cambiar sus líneas, o la flecha atrás para cambiar la parada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta igal ajal peatuse nime, et muuta selle liine, või tagasinoolt, et muuta peatust."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakatu geltokiaren izena edonoiz haren lineak aldatzeko, edo atzera-gezia geltokia aldatzeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta pysäkin nimeä milloin tahansa vaihtaaksesi sen linjat tai paluunuolta vaihtaaksesi pysäkin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap ang pangalan ng hintuan anumang oras para palitan ang mga linya nito, o ang back arrow para palitan ang hintuan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le nom de l’arrêt à tout moment pour changer de lignes, ou la flèche de retour pour changer d’arrêt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו על שם התחנה בכל עת כדי להחליף את הקווים שלה, או על חץ החזרה כדי להחליף את התחנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टॉप की लाइनें बदलने के लिए कभी भी स्टॉप के नाम पर टैप करें, या स्टॉप बदलने के लिए वापस जाने वाले तीर पर।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nias lub npe chaw nres txhua lub sijhawm los hloov nws cov kab, lossis nias tus xub rov qab los hloov chaw nres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints bármikor a megálló nevére a járatai módosításához, vagy a vissza nyílra a megálló módosításához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il nome della fermata in qualsiasi momento per cambiarne le linee, o la freccia indietro per cambiare la fermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留所名をタップするといつでも系統を、戻る矢印をタップすると停留所を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든 정류장 이름을 탭하면 노선을, 뒤로 화살표를 탭하면 정류장을 변경할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bet kada palieskite stotelės pavadinimą, kad pakeistumėte jos maršrutus, arba rodyklę atgal, kad pakeistumėte stotelę."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på holdeplassnavnet når som helst for å bytte linjer, eller på tilbakepilen for å bytte holdeplass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik altijd op de haltenaam om de lijnen te wijzigen, of op de terugpijl om de halte te wijzigen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
