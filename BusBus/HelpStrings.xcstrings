    "faq.how-many-lines-can-i-watch.details" : {
      "comment" : "FAQ answer (Markdown)",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በአንድ ፌርማታ እስከ ሦስት መስመሮች፤ ስለዚህ እያንዳንዱ በሰሌዳው ላይ ግልጽ መንገድ ያገኛል። አንዱን ለመቀየር የተመረጠ መስመር ይንኩና በሌላ ይተኩት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى ثلاثة خطوط لكل محطة، ليحصل كل خط على مسار واضح على اللوحة. لتغيير أحدها، اضغط على خط محدد لاستبداله بخط آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až tři linky na zastávku, aby každá měla na tabuli přehlednou trasu. Chceš-li některou změnit, klepni na vybranou linku a vyměň ji za jinou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu drei Linien pro Haltestelle, damit jede auf der Tafel eine übersichtliche Strecke bekommt. Um eine zu ändern, tippe auf eine ausgewählte Linie und tausche sie gegen eine andere aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to three lines per stop, so each one gets a clear route on the board. To change one, tap a selected line to swap it out for another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta tres líneas por parada, para que cada una tenga un recorrido claro en el panel. Para cambiar una, toca una línea seleccionada y sustitúyela por otra."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuni kolme liini peatuse kohta, et igaüks saaks tabloole selge marsruudi. Liini muutmiseks puuduta valitud liini ja vaheta see teise vastu."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehienez hiru linea geltoki bakoitzeko, bakoitzak panelean ibilbide argi bat izan dezan. Bat aldatzeko, sakatu hautatutako linea bat eta ordeztu beste batekin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enintään kolmea linjaa pysäkkiä kohden, jotta jokainen saa taululle selkeän reitin. Jos haluat vaihtaa linjan, napauta valittua linjaa ja vaihda se toiseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanggang tatlong linya bawat hintuan, para malinaw ang ruta ng bawat isa sa board. Para magpalit, i-tap ang isang napiling linya at palitan ito ng iba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à trois lignes par arrêt, pour que chacune ait un itinéraire bien lisible sur le tableau. Pour en changer, touchez une ligne sélectionnée afin de la remplacer par une autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עד שלושה קווים לכל תחנה, כך שלכל אחד מהם יש מסלול ברור על הלוח. כדי להחליף קו, הקישו על קו שנבחר והחליפו אותו בקו אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर स्टॉप पर ज़्यादा से ज़्यादा तीन लाइनें, ताकि बोर्ड पर हर लाइन का रूट साफ़ दिखे। किसी लाइन को बदलने के लिए, चुनी हुई लाइन पर टैप करें और उसकी जगह दूसरी लाइन चुनें।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Txog peb kab rau ib qho chaw nres, kom txhua kab muaj ib txoj kev pom meej ntawm daim txiag. Yuav hloov ib kab, nias ib kab uas xaiv lawm kom pauv nws rau lwm kab."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megállónként legfeljebb hármat, hogy mindegyik jól követhető útvonalat kapjon a kijelzőn. Módosításhoz koppints egy kiválasztott járatra, és cseréld le egy másikra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a tre linee per fermata, così ognuna ha un percorso ben leggibile sul tabellone. Per cambiarne una, tocca una linea selezionata e sostituiscila con un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つの停留所につき最大3系統までです。そのため、各系統の路線がボード上ではっきり見やすく表示されます。変更したいときは、選択中の系統をタップして別の系統と入れ替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정류장당 최대 3개 노선까지 볼 수 있어, 보드에서 각 노선을 한눈에 알아볼 수 있습니다. 노선을 바꾸려면 선택된 노선을 탭해 다른 노선으로 교체하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iki trijų maršrutų vienoje stotelėje, kad kiekvienas švieslentėje turėtų aiškią trasą. Norėdami pakeisti maršrutą, palieskite pasirinktą maršrutą ir pakeiskite jį kitu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptil tre linjer per holdeplass, slik at hver av dem får en tydelig rute på tavlen. Vil du bytte ut en, trykker du på en valgt linje og bytter den mot en annen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaal drie lijnen per halte, zodat elke lijn een duidelijke route op het bord krijgt. Om er een te wijzigen, tik je op een gekozen lijn en wissel je die voor een andere."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptil tre linjer per haldeplass, slik at kvar av dei får ei tydeleg rute på tavla. Vil du byte ut ei, trykkjer du på ei vald linje og byter ho mot ei anna."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਸਟਾਪ ਲਈ ਤਿੰਨ ਲਾਈਨਾਂ ਤੱਕ, ਤਾਂ ਜੋ ਹਰ ਇੱਕ ਦਾ ਬੋਰਡ ਉੱਤੇ ਸਾਫ਼ ਰੂਟ ਦਿਖੇ। ਕੋਈ ਲਾਈਨ ਬਦਲਣ ਲਈ, ਚੁਣੀ ਹੋਈ ਲਾਈਨ ਉੱਤੇ ਟੈਪ ਕਰਕੇ ਉਸ ਦੀ ਥਾਂ ਹੋਰ ਲਾਈਨ ਲਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalnie trzy linie na przystanek, aby każda miała na tablicy czytelną trasę. Aby zmienić linię, stuknij jedną z wybranych i zamień ją na inną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até três linhas por ponto, para que cada uma tenha um trajeto bem visível no painel. Para trocar uma delas, toque em uma linha selecionada e substitua-a por outra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até três carreiras por paragem, para que cada uma tenha um percurso bem visível no painel. Para mudar uma delas, toque numa carreira selecionada e troque-a por outra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Până la trei linii pe stație, ca fiecare să aibă un traseu clar pe panou. Ca să schimbi una, atinge o linie selectată și înlocuiește-o cu alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До трёх маршрутов на одну остановку, чтобы каждый был чётко виден на табло. Чтобы заменить маршрут, нажмите на выбранный и выберите вместо него другой."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tri linije na postajo, da ima vsaka na tabli jasno progo. Če želiš katero spremeniti, tapni izbrano linijo in jo zamenjaj z drugo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilaa saddex khad joogsi kasta, si mid kastaa u helo waddo cad oo looxa ku jirta. Si aad mid u beddesho, taabo khad la doortay oo ku beddel mid kale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till tre linjer per hållplats, så att varje linje får en tydlig sträcka på tavlan. Vill du byta en linje trycker du på en vald linje och byter ut den mot en annan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her durak için en fazla üç hat; böylece her birinin panoda net bir güzergâhı olur. Bir hattı değiştirmek için seçili hatta dokunup onu başka bir hatla değiştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tối đa ba tuyến cho mỗi điểm dừng, để mỗi tuyến có một lộ trình rõ ràng trên bảng. Để thay đổi, chạm vào một tuyến đã chọn để đổi sang tuyến khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个车站最多三条线路，这样每条线路在看板上都能清晰显示。如需更换，轻点已选中的线路，把它换成另一条即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個巴士站最多三條路線，讓每條路線在看板上都能清楚顯示。如要更換，輕按已選取的路線，將它換成另一條即可。"
          }
        }
      }
