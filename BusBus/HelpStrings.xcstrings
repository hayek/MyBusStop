    "faq.is-this-an-official-app.details" : {
      "comment" : "FAQ answer (Markdown)",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አይደለም። «የእኔ ፌርማታ» ራሱን የቻለ መተግበሪያ ነው። በማንኛውም የትራንስፖርት ድርጅት ወይም የአውቶቡስ ኦፕሬተር አልተሠራም፣ አልተደገፈምም፤ እነሱ የሚያትሙትን ይፋዊ መረጃ ብቻ ያሳያል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا. «محطتي» تطبيق مستقل، لم تطوّره أو تعتمده أي هيئة نقل أو مشغّل حافلات؛ وهو يعرض فقط البيانات العامة التي ينشرونها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne. Moje zastávka je nezávislá aplikace. Nevytvořil ji ani nepodporuje žádný dopravní podnik ani autobusový dopravce; jen zobrazuje veřejná data, která zveřejňují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Meine Haltestelle ist eine unabhängige App. Sie wird von keinem Verkehrsbetrieb oder Busunternehmen entwickelt oder unterstützt, sondern zeigt nur die öffentlichen Daten an, die diese veröffentlichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. My Bus Stop is an independent app. It is not made or endorsed by any transit agency or bus operator; it only displays the public data they publish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Mi parada es una app independiente. No la ha creado ni respaldado ninguna empresa de transporte ni operador de autobuses; solo muestra los datos públicos que ellos publican."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei. Minu peatus on sõltumatu rakendus. Seda ei ole loonud ega heaks kiitnud ükski ühistranspordiasutus ega bussiettevõte; see kuvab ainult nende avaldatud avalikke andmeid."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez. Nire geltokia aplikazio independentea da. Ez du garraio-agentziek edo autobus-operadoreek egin ez babestu; haiek argitaratzen dituzten datu publikoak erakusten ditu soilik."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei. Oma pysäkki on itsenäinen sovellus. Sitä ei ole tehnyt tai hyväksynyt mikään liikennöitsijä tai bussiyhtiö; se vain näyttää niiden julkaisemaa julkista dataa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi. Ang Aking Bus Stop ay isang independent na app. Hindi ito gawa o inendorso ng anumang ahensya ng transportasyon o bus operator; ipinapakita lang nito ang pampublikong data na inilalathala nila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. Mon arrêt est une app indépendante. Elle n’est ni conçue ni approuvée par un réseau de transport ou un opérateur de bus ; elle se contente d’afficher les données publiques qu’ils publient."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא. התחנה שלי היא אפליקציה עצמאית. היא לא פותחה על ידי אף רשות תחבורה או מפעיל אוטובוסים ולא קיבלה את חסותם; היא רק מציגה את הנתונים הציבוריים שהם מפרסמים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नहीं। मेरा बस स्टॉप एक स्वतंत्र ऐप है। इसे किसी ट्रांज़िट एजेंसी या बस ऑपरेटर ने न तो बनाया है और न ही इसका समर्थन किया है; यह सिर्फ़ उनके द्वारा प्रकाशित सार्वजनिक डेटा दिखाता है।"
