    "faq.what-is-my-bus-stop.details" : {
      "comment" : "FAQ answer (Markdown)",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«የእኔ ፌርማታ» የእርስዎን iPhone፣ iPad ወይም Mac በየቀኑ ለሚጠቀሙበት ፌርማታ የቀጥታ መድረሻ ሰሌዳ ያደርገዋል። ፌርማታ እና እስከ ሦስት መስመሮች ይምረጡ፤ ሰሌዳው ቀጣዩ አውቶቡስና ከእሱ ቀጥሎ ያለው ለመድረስ ስንት ደቂቃ እንደቀራቸው፣ እያንዳንዱ አውቶቡስም አሁን በመስመሩ ላይ የት እንዳለ ያሳያል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحوّل «محطتي» جهاز iPhone أو iPad أو Mac إلى لوحة وصول مباشرة للمحطة التي تستخدمها كل يوم. اختر محطة وحتى ثلاثة خطوط، وستعرض لك اللوحة كم دقيقة تبقّت حتى وصول الحافلة التالية والتي تليها، وأين تقع كل حافلة على مسارها في هذه اللحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moje zastávka promění tvůj iPhone, iPad nebo Mac v živou tabuli příjezdů pro zastávku, kterou používáš každý den. Vyber zastávku a až tři linky a tabule ukáže, za kolik minut přijede příští autobus, ten po něm a kde je právě teď každý autobus na své trase."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Haltestelle macht dein iPhone, iPad oder deinen Mac zur Live-Abfahrtstafel für die Haltestelle, die du jeden Tag nutzt. Wähle eine Haltestelle und bis zu drei Linien, und die Tafel zeigt dir, in wie vielen Minuten der nächste Bus kommt, wann der übernächste folgt und wo sich jeder Bus gerade auf seiner Strecke befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Bus Stop turns your iPhone, iPad or Mac into a live arrivals board for the stop you use every day. Pick a stop and up to three lines, and the board shows how many minutes until the next bus, the one after it, and where each bus is along its route right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi parada convierte tu iPhone, iPad o Mac en un panel de llegadas en tiempo real para la parada que usas cada día. Elige una parada y hasta tres líneas, y el panel te muestra cuántos minutos faltan para el próximo autobús y para el siguiente, y dónde está cada autobús en su recorrido en este momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minu peatus muudab su iPhone'i, iPadi või Maci reaalajas saabumistablooks peatuse jaoks, mida kasutad iga päev. Vali peatus ja kuni kolm liini ning tabloo näitab, mitu minutit on järgmise bussini ja sellele järgneva bussini ning kus iga buss oma marsruudil parasjagu asub."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nire geltokiak zure iPhone, iPad edo Mac zuzeneko iritsiera-panel bihurtzen du egunero erabiltzen duzun geltokirako. Aukeratu geltoki bat eta gehienez hiru linea, eta panelak erakutsiko dizu zenbat minutu falta diren hurrengo autobusa iristeko, haren ondorengoa noiz datorren eta autobus bakoitza une honetan bere ibilbidean non dagoen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oma pysäkki muuttaa iPhonesi, iPadisi tai Macisi reaaliaikaiseksi saapumistauluksi pysäkille, jota käytät joka päivä. Valitse pysäkki ja enintään kolme linjaa, niin taulu näyttää, montako minuuttia on seuraavaan bussiin ja sitä seuraavaan, sekä missä kukin bussi on reitillään juuri nyt."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagawa ng Aking Bus Stop ang iyong iPhone, iPad o Mac na live arrivals board para sa hintuang ginagamit mo araw-araw. Pumili ng hintuan at hanggang tatlong linya, at ipapakita ng board kung ilang minuto pa bago ang susunod na bus at ang kasunod nito, at kung nasaan na ngayon ang bawat bus sa ruta nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon arrêt transforme votre iPhone, iPad ou Mac en tableau des passages en temps réel pour l’arrêt que vous utilisez tous les jours. Choisissez un arrêt et jusqu’à trois lignes : le tableau vous indique dans combien de minutes passe le prochain bus, puis le suivant, et où se trouve chaque bus sur son itinéraire à cet instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחנה שלי הופכת את ה‑iPhone, ה‑iPad או ה‑Mac שלכם ללוח הגעות חי של התחנה שאתם משתמשים בה כל יום. בחרו תחנה ועד שלושה קווים, והלוח יראה בעוד כמה דקות מגיע האוטובוס הבא, זה שאחריו, והיכן נמצא כל אוטובוס לאורך המסלול שלו ממש עכשיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरा बस स्टॉप आपके iPhone, iPad या Mac को उस स्टॉप का लाइव अराइवल बोर्ड बना देता है जिसका आप रोज़ इस्तेमाल करते हैं। एक स्टॉप और ज़्यादा से ज़्यादा तीन लाइनें चुनें, और बोर्ड दिखाएगा कि अगली बस और उसके बाद वाली बस कितने मिनट में आएगी, और हर बस इस वक़्त अपने रूट पर कहाँ है।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Bus Stop hloov koj lub iPhone, iPad lossis Mac ua ib daim txiag qhia tsheb tuaj txog ncaj qha rau qhov chaw nres koj siv txhua hnub. Xaiv ib qho chaw nres thiab txog peb kab, ces daim txiag qhia tshuav pes tsawg feeb lub tsheb npav tom ntej mam tuaj, lub tom qab nws, thiab txhua lub tsheb npav nyob qhov twg ntawm nws txoj kev tam sim no."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Megállóm élő érkezési kijelzővé alakítja az iPhone-odat, iPadedet vagy Macedet ahhoz a megállóhoz, amelyet minden nap használsz. Válassz egy megállót és legfeljebb három járatot, és a kijelző megmutatja, hány perc múlva jön a következő busz, mikor az utána következő, és hol tart éppen minden busz az útvonalán."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mia fermata trasforma il tuo iPhone, iPad o Mac in un tabellone degli arrivi in tempo reale per la fermata che usi ogni giorno. Scegli una fermata e fino a tre linee: il tabellone ti mostra tra quanti minuti arriva il prossimo autobus, quello successivo e dove si trova ogni autobus lungo il suo percorso in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイバス停は、iPhone、iPad、Macを、毎日使う停留所のリアルタイム到着案内ボードに変えるアプリです。停留所と最大3つの系統を選ぶと、次のバスとその次のバスがあと何分で来るか、そして各バスがいま路線のどこを走っているかがボードに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 버스 정류장은 iPhone, iPad 또는 Mac을 매일 이용하는 정류장의 실시간 도착 안내판으로 바꿔 줍니다. 정류장 하나와 노선을 최대 3개까지 선택하면, 다음 버스와 그다음 버스가 몇 분 후에 도착하는지, 그리고 각 버스가 지금 노선의 어디쯤 있는지 보드에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mano stotelė“ paverčia jūsų „iPhone“, „iPad“ ar „Mac“ realaus laiko atvykimų švieslente stotelei, kuria naudojatės kasdien. Pasirinkite stotelę ir iki trijų maršrutų – švieslentė parodys, po kiek minučių atvyks kitas autobusas ir po jo einantis, taip pat kur kiekvienas autobusas šiuo metu yra savo maršrute."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min holdeplass gjør iPhonen, iPaden eller Macen din til en sanntidstavle for holdeplassen du bruker hver dag. Velg en holdeplass og opptil tre linjer, så viser tavlen hvor mange minutter det er til neste buss og den etter den, og hvor hver buss befinner seg langs ruten akkurat nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn halte maakt van je iPhone, iPad of Mac een live aankomstbord voor de halte die je elke dag gebruikt. Kies een halte en maximaal drie lijnen, en het bord toont over hoeveel minuten de volgende bus komt, de bus daarna, en waar elke bus zich nu op zijn route bevindt."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min haldeplass gjer iPhonen, iPaden eller Macen din til ei sanntidstavle for haldeplassen du brukar kvar dag. Vel ein haldeplass og opptil tre linjer, så viser tavla kor mange minutt det er til neste buss og den etter han, og kvar kvar buss er langs ruta akkurat no."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੇਰਾ ਬੱਸ ਸਟਾਪ ਤੁਹਾਡੇ iPhone, iPad ਜਾਂ Mac ਨੂੰ ਤੁਹਾਡੇ ਰੋਜ਼ਾਨਾ ਵਾਲੇ ਸਟਾਪ ਲਈ ਲਾਈਵ ਆਮਦ ਬੋਰਡ ਬਣਾ ਦਿੰਦੀ ਹੈ। ਇੱਕ ਸਟਾਪ ਅਤੇ ਤਿੰਨ ਲਾਈਨਾਂ ਤੱਕ ਚੁਣੋ, ਅਤੇ ਬੋਰਡ ਦਿਖਾਉਂਦਾ ਹੈ ਕਿ ਅਗਲੀ ਬੱਸ ਵਿੱਚ ਕਿੰਨੇ ਮਿੰਟ ਬਾਕੀ ਹਨ, ਉਸ ਤੋਂ ਅਗਲੀ ਬੱਸ, ਅਤੇ ਇਸ ਵੇਲੇ ਹਰ ਬੱਸ ਆਪਣੇ ਰੂਟ ਉੱਤੇ ਕਿੱਥੇ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mój przystanek zamienia Twojego iPhone’a, iPada lub Maca w tablicę odjazdów na żywo dla przystanku, z którego korzystasz na co dzień. Wybierz przystanek i maksymalnie trzy linie, a tablica pokaże, za ile minut przyjedzie najbliższy autobus i kolejny po nim oraz gdzie na trasie jest teraz każdy z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meu ponto de ônibus transforma seu iPhone, iPad ou Mac em um painel de chegadas em tempo real para o ponto que você usa todo dia. Escolha um ponto e até três linhas, e o painel mostra quantos minutos faltam para o próximo ônibus e para o seguinte, além de onde cada ônibus está no trajeto neste momento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A minha paragem transforma o seu iPhone, iPad ou Mac num painel de chegadas em tempo real para a paragem que utiliza todos os dias. Escolha uma paragem e até três carreiras, e o painel mostra quantos minutos faltam para o próximo autocarro e para o seguinte, e onde se encontra cada autocarro no seu percurso neste preciso momento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stația mea transformă iPhone-ul, iPadul sau Macul tău într-un panou de sosiri în timp real pentru stația pe care o folosești zilnic. Alege o stație și până la trei linii, iar panoul îți arată în câte minute vine următorul autobuz, pe cel de după și unde se află acum fiecare autobuz pe traseul său."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Моя остановка» превращает ваш iPhone, iPad или Mac в табло прибытия в реальном времени для остановки, которой вы пользуетесь каждый день. Выберите остановку и до трёх маршрутов — и табло покажет, через сколько минут придёт следующий автобус и тот, что за ним, а также где сейчас находится каждый автобус на своём маршруте."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moja postaja spremeni tvoj iPhone, iPad ali Mac v tablo prihodov v živo za postajo, ki jo uporabljaš vsak dan. Izberi postajo in do tri linije, tabla pa pokaže, čez koliko minut pripelje naslednji avtobus, kdaj pride tisti za njim in kje na progi je ta hip vsak avtobus."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Bus Stop wuxuu iPhone-kaaga, iPad-kaaga ama Mac-kaaga u beddelaa loox imaatin toos ah oo loogu talagalay joogsiga aad maalin kasta isticmaasho. Dooro joogsi iyo ilaa saddex khad, looxuna wuxuu muujiyaa inta daqiiqo ee u hadhay baska xiga, kan ka dambeeya, iyo meesha bas kastaa hadda ka joogo waddadiisa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min hållplats gör din iPhone, iPad eller Mac till en realtidstavla med ankomster för hållplatsen du använder varje dag. Välj en hållplats och upp till tre linjer, så visar tavlan hur många minuter det är kvar till nästa buss och bussen efter den, och var varje buss befinner sig längs sin sträcka just nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durağım; iPhone, iPad veya Mac'ini her gün kullandığın durak için canlı bir varış panosuna dönüştürür. Bir durak ve en fazla üç hat seç; pano, sonraki otobüse ve ondan sonrakine kaç dakika kaldığını ve her otobüsün şu anda güzergâhının neresinde olduğunu gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trạm Xe Của Tôi biến iPhone, iPad hoặc Mac của bạn thành bảng giờ xe đến theo thời gian thực cho điểm dừng bạn dùng hằng ngày. Chọn một điểm dừng và tối đa ba tuyến, bảng sẽ cho biết còn bao nhiêu phút nữa đến chuyến kế tiếp, chuyến sau đó, và từng xe buýt đang ở đâu trên lộ trình ngay lúc này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我的公交站”能把你的 iPhone、iPad 或 Mac 变成你每天所用车站的实时到站看板。选择一个车站和最多三条线路，看板就会显示下一班车和再下一班车还有几分钟到站，以及每辆车此刻在线路上的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「我的巴士站」能把你的 iPhone、iPad 或 Mac 變成你每天使用的巴士站的即時到站看板。選擇一個巴士站和最多三條路線，看板就會顯示下一班巴士和再下一班還有幾分鐘到站，以及每班巴士此刻正在路線上的哪個位置。"
          }
        }
      }
    },
