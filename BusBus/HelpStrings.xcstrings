        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyllä. Taulu näyttää viimeisimmät tiedossa olevat ajat ollessaan offline-tilassa, tarkistaa tilanteen automaattisesti uudelleen ja palaa itsestään, kun yhteys palaa – sitä ei tarvitse koskea. Jos sovellus käynnistetään uudelleen, se avautuu suoraan tauluun."
          }
        },
        "fil" : {
          "stringUnit" : {
