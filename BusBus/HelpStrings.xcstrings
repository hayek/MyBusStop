      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አዎ። መተግበሪያው በነባሪ የመሣሪያዎን ቋንቋ ይከተላል፤ በ**ቅንብሮች → ቋንቋ** ደግሞ ለዚህ መተግበሪያ ብቻ ሌላ ቋንቋ መምረጥ ይችላሉ። ለውጡ ወዲያውኑ ይተገበራል፤ ለዕብራይስጥና ለዓረብኛ ከቀኝ ወደ ግራ አቀማመጥንም ጨምሮ። ዊጀቶችዎ እና Apple Watch የመረጡትን ቋንቋ ይከተላሉ።"
