            "value" : "Varför ser jag inga hållplatser nära mig?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınımdaki durakları neden göremiyorum?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tại sao tôi không thấy các điểm dừng gần mình?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么看不到我附近的车站？"
          }
