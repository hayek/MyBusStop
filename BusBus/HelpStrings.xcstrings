        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. La mia fermata è un’app indipendente. Non è realizzata né approvata da alcuna azienda di trasporto o gestore di autobus; mostra soltanto i dati pubblici che pubblicano."
          }
