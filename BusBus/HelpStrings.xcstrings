          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ano. Aplikace se ve výchozím stavu řídí jazykem tvého zařízení a v **Nastavení → Jazyk** si můžeš jen pro tuto aplikaci zvolit jiný. Změna platí okamžitě, včetně rozvržení zprava doleva pro hebrejštinu a arabštinu. Tvoje widgety i Apple Watch se řídí zvoleným jazykem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Standardmäßig folgt die App der Sprache deines Geräts, und unter **Einstellungen → Sprache** kannst du nur für diese App eine andere wählen. Die Änderung gilt sofort, einschließlich der Rechts-nach-links-Darstellung für Hebräisch und Arabisch. Deine Widgets und deine Apple Watch übernehmen die gewählte Sprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. The app follows your device's language by default, and **Settings → Language** lets you choose a different one for this app alone. The change applies right away, including right-to-left layout for Hebrew and Arabic. Your widgets and Apple Watch follow the language you choose."
          }
        },
        "es" : {
