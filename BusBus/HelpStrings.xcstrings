    "faq.where-does-the-data-come-from.details" : {
      "comment" : "FAQ answer (Markdown)",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የትራንስፖርት ድርጅቶች ለአውቶቡሶቻቸው ከሚያትሙት ክፍት የቀጥታ መረጃ። መተግበሪያው በቀጥታ ከእያንዳንዱ ድርጅት አገልግሎት ያነበዋል፤ ለሚያዩት መረጃ ምንጩ በ**ቅንብሮች** ግርጌ ላይ ይታያል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من البيانات المفتوحة الفورية التي تنشرها هيئات النقل عن حافلاتها. يقرأ التطبيق هذه البيانات مباشرة من خدمة كل هيئة، وتظهر الإشارة إلى مصدر البيانات التي تراها أسفل **الإعدادات**."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z otevřených dat v reálném čase, která dopravní podniky zveřejňují o svých autobusech. Aplikace je čte přímo ze služby každého dopravce a uvedení zdroje dat, na která se díváš, najdeš úplně dole v **Nastavení**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus den offenen Echtzeitdaten, die Verkehrsbetriebe für ihre Busse veröffentlichen. Die App liest sie direkt aus dem Dienst des jeweiligen Betriebs; die Quellenangabe für die angezeigten Daten findest du ganz unten in den **Einstellungen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the open, real-time data that transit agencies publish for their buses. The app reads it directly from each agency's service, and the credit for the data you're looking at is shown at the bottom of **Settings**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De los datos abiertos en tiempo real que las empresas de transporte publican sobre sus autobuses. La app los lee directamente del servicio de cada empresa, y la atribución de los datos que estás viendo aparece al final de **Ajustes**."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avatud reaalajas andmetest, mida ühistranspordiasutused oma busside kohta avaldavad. Rakendus loeb neid otse iga asutuse teenusest ning viide andmete allikale, mida parasjagu vaatad, on näha **Seadete** allosas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garraio-agentziek beren autobusetarako argitaratzen dituzten denbora errealeko datu irekietatik. Aplikazioak zuzenean irakurtzen ditu agentzia bakoitzaren zerbitzutik, eta ikusten ari zaren datuen iturria **Ezarpenak** ataleko behealdean agertzen da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoimesta reaaliaikaisesta datasta, jota liikennöitsijät julkaisevat busseistaan. Sovellus lukee sen suoraan kunkin liikennöitsijän palvelusta, ja katsomasi datan lähde näkyy **Asetukset**-näkymän alareunassa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mula sa bukas at real-time na data na inilalathala ng mga ahensya ng transportasyon para sa kanilang mga bus. Direktang kinukuha ito ng app mula sa serbisyo ng bawat ahensya, at makikita sa ibaba ng **Settings** ang pagkilala sa pinagmulan ng data na tinitingnan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des données ouvertes en temps réel que les réseaux de transport publient pour leurs bus. L’app les lit directement auprès du service de chaque réseau, et la source des données affichées est indiquée en bas des **Réglages**."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מהנתונים הפתוחים בזמן אמת שרשויות התחבורה מפרסמות על האוטובוסים שלהן. האפליקציה קוראת אותם ישירות מהשירות של כל רשות, והקרדיט על הנתונים שמוצגים לכם מופיע בתחתית מסך ה**הגדרות**."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस खुले, रियल-टाइम डेटा से जो ट्रांज़िट एजेंसियाँ अपनी बसों के लिए प्रकाशित करती हैं। ऐप यह डेटा सीधे हर एजेंसी की सेवा से पढ़ता है, और जो डेटा आप देख रहे हैं उसका श्रेय **सेटिंग्स** में सबसे नीचे दिखाया जाता है।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ntawm cov ntaub ntawv qhib, ncaj qha uas cov koom haum tsheb tshaj tawm rau lawv cov tsheb npav. App nyeem ncaj qha ntawm txhua lub koom haum lub kev pabcuam, thiab lub npe ntawm tus muab cov ntaub ntawv koj tabtom saib nyob hauv qab ntawm **Settings**."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közlekedési társaságok által a buszaikról közzétett nyílt, valós idejű adatokból. Az app közvetlenül az egyes társaságok szolgáltatásából olvassa ki őket, a megjelenített adatok forrását pedig a **Beállítások** alján találod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai dati aperti in tempo reale che le aziende di trasporto pubblicano per i loro autobus. L’app li legge direttamente dal servizio di ciascuna azienda, e la fonte dei dati che stai guardando è indicata in fondo alle **Impostazioni**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交通事業者が自社のバスについて公開している、オープンなリアルタイムデータを使っています。アプリは各事業者のサービスから直接データを読み込んでおり、表示中のデータの提供元は**設定**の一番下に記載されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교통 기관이 자사 버스에 대해 공개하는 실시간 오픈 데이터를 사용합니다. 앱은 각 기관의 서비스에서 데이터를 직접 읽어 오며, 현재 보고 있는 데이터의 출처는 **설정** 맨 아래에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iš atvirų realaus laiko duomenų, kuriuos apie savo autobusus skelbia viešojo transporto įstaigos. Programėlė juos skaito tiesiogiai iš kiekvienos įstaigos paslaugos, o šių duomenų šaltinis nurodytas **Nustatymų** apačioje."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra de åpne sanntidsdataene som kollektivselskapene publiserer for bussene sine. Appen henter dem direkte fra hvert selskaps tjeneste, og kilden til dataene du ser på, står nederst i **Innstillinger**."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van de open, realtime gegevens die vervoersbedrijven over hun bussen publiceren. De app leest ze rechtstreeks uit de dienst van elk vervoersbedrijf, en de bronvermelding voor de gegevens die je ziet, staat onderaan in **Instellingen**."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frå dei opne sanntidsdataa som kollektivselskapa publiserer for bussane sine. Appen hentar dei direkte frå tenesta til kvart selskap, og kjelda til dataa du ser på, står nedst i **Innstillingar**."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਸ ਖੁੱਲ੍ਹੇ, ਰੀਅਲ-ਟਾਈਮ ਡਾਟਾ ਤੋਂ ਜੋ ਟ੍ਰਾਂਜ਼ਿਟ ਏਜੰਸੀਆਂ ਆਪਣੀਆਂ ਬੱਸਾਂ ਲਈ ਜਾਰੀ ਕਰਦੀਆਂ ਹਨ। ਐਪ ਇਸ ਨੂੰ ਸਿੱਧਾ ਹਰ ਏਜੰਸੀ ਦੀ ਸੇਵਾ ਤੋਂ ਪੜ੍ਹਦੀ ਹੈ, ਅਤੇ ਤੁਹਾਡੇ ਸਾਹਮਣੇ ਵਾਲੇ ਡਾਟਾ ਦਾ ਸਿਹਰਾ **ਸੈਟਿੰਗਾਂ** ਦੇ ਹੇਠਾਂ ਦਿਖਾਇਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z otwartych danych w czasie rzeczywistym, które przewoźnicy publikują o swoich autobusach. Aplikacja pobiera je bezpośrednio z serwisu każdego przewoźnika, a źródło wyświetlanych danych jest podane na dole ekranu **Ustawienia**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos dados abertos em tempo real que as empresas de transporte publicam sobre seus ônibus. O app lê essas informações diretamente do serviço de cada empresa, e o crédito pelos dados que você está vendo aparece no fim de **Ajustes**."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos dados abertos em tempo real que os operadores de transportes publicam sobre os seus autocarros. A app lê-os diretamente do serviço de cada operador, e a fonte dos dados que está a ver é indicada no fundo das **Definições**."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din datele deschise, în timp real, pe care companiile de transport le publică pentru autobuzele lor. Aplicația le citește direct din serviciul fiecărei companii, iar sursa datelor pe care le vezi este menționată în partea de jos a **Configurărilor**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из открытых данных в реальном времени, которые транспортные операторы публикуют о своих автобусах. Приложение получает их напрямую из сервиса каждого оператора, а источник данных, которые вы видите, указан внизу раздела **Настройки**."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iz odprtih podatkov v realnem času, ki jih prevozniki objavljajo za svoje avtobuse. Aplikacija jih bere neposredno iz storitve vsakega prevoznika, navedba vira za podatke, ki jih gledaš, pa je na dnu **Nastavitev**."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxay ka yimaadaan xogta furan ee waqtiga dhabta ah ee hay'adaha gaadiidku u daabacaan basaskooda. App-ku wuxuu si toos ah uga akhriyaa adeegga hay'ad kasta, mahadnaqa xogta aad eegaysaana waxaa lagu muujiyaa hoosta **Dejinta**."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från de öppna realtidsdata som kollektivtrafikbolagen publicerar om sina bussar. Appen hämtar dem direkt från varje bolags tjänst, och källan till de data du tittar på anges längst ned i **Inställningar**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplu taşıma kurumlarının otobüsleri için yayımladığı açık, gerçek zamanlı verilerden. Uygulama bu verileri doğrudan her kurumun hizmetinden okur; baktığın verilerin kaynağı **Ayarlar**'ın en altında belirtilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ dữ liệu mở theo thời gian thực mà các đơn vị vận tải công bố cho xe buýt của họ. Ứng dụng đọc dữ liệu trực tiếp từ dịch vụ của từng đơn vị, và nguồn của dữ liệu bạn đang xem được ghi ở cuối trang **Cài đặt**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自各交通机构为其公交车公开发布的实时开放数据。App 直接从各机构的服务读取数据，当前所显示数据的来源署名列在**设置**的底部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自各交通機構為旗下巴士公開發佈的即時開放資料。App 會直接從各機構的服務讀取資料，你正在查看的資料來源標示於**設定**的最下方。"
          }
        }
      }
    },
    "faq.where-does-the-data-come-from.title" : {
      "comment" : "FAQ question",
      "extractionState" : "manual",
