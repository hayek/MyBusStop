    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለማዋቀሪያ ገጹ በአቅራቢያዎ ያሉ የአውቶቡስ ፌርማታዎችን ያገኛል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر على محطات الحافلات القريبة منك لشاشة الإعداد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najde autobusové zastávky ve tvém okolí pro obrazovku nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Haltestellen in deiner Nähe für die Einrichtung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds bus stops near you for the setup screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca paradas de autobús cerca de ti para la pantalla de configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiab seadistuskuval sinu lähedal asuvad bussipeatused."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inguruko autobus-geltokiak aurkitzen ditu konfigurazio-pantailarako."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsii lähelläsi olevat bussipysäkit asetusnäyttöä varten."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinahanap ang mga hintuan ng bus na malapit sa iyo para sa setup screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les arrêts de bus proches de vous pour l’écran de configuration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאתר תחנות אוטובוס בקרבתך עבור מסך ההגדרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटअप स्क्रीन के लिए आपके पास के बस स्टॉप खोजता है।"
          }
        },
        "hmn-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nrhiav cov chaw nres tsheb npav ze koj rau nplooj teeb tsa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megkeresi a közeli buszmegállókat a beállítási képernyőhöz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova le fermate vicino a te per la configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定画面で近くのバス停留所を探すために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 화면에서 주변 버스 정류장을 찾는 데 사용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randa netoliese esančias autobusų stoteles sąrankos ekranui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finner bussholdeplasser i nærheten til oppsettskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindt bushaltes in je buurt voor het instelscherm."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn busshaldeplassar i nærleiken til oppsettskjermen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੈੱਟਅੱਪ ਸਕਰੀਨ ਲਈ ਤੁਹਾਡੇ ਨੇੜਲੇ ਬੱਸ ਸਟਾਪ ਲੱਭਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduje pobliskie przystanki autobusowe na potrzeby ekranu konfiguracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra pontos de ônibus perto de você para a tela de configuração."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra paragens de autocarro perto de si para o ecrã de configuração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Găsește stațiile de autobuz din apropiere pentru ecranul de configurare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находит остановки рядом с вами для экрана настройки."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poišče avtobusne postaje v tvoji bližini za zaslon nastavitve."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxuu helaa joogsiyada baska ee kuu dhow si loogu isticmaalo shaashadda diyaarinta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hittar busshållplatser nära dig för inställningsskärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum ekranı için yakınındaki otobüs duraklarını bulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm các điểm dừng xe buýt gần bạn cho màn hình thiết lập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在设置界面查找您附近的公交站点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為設定畫面尋找你附近的巴士站。"
          }
        }
      }
    }
