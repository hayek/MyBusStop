<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Attest, for App Check on the transit proxy (Telemetry.swift). iOS and tvOS device Release builds
	     only; the simulator and Debug use App Check's debug provider. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<!-- Shared with the widget (AppGroup.swift), as in Config/BusBus.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hayek.BusBus</string>
	</array>
	<!-- The saved stops, shared with the rider's other devices (CloudHistory.swift). -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
