// Template for Config/Secrets.xcconfig — local API keys for DEBUG builds of the keyed transit feeds.
// Release builds never see these and hold no key at all: keyed providers will reach their APIs
// through a server-side proxy that adds the key (KeyedEndpoint.proxy), and are unavailable until then.
//
// Secrets.xcconfig is gitignored: never commit real keys. Create it either way:
//   scripts/fill-secrets.sh                   # writes it from the Keychain ("BusBus API key: <id>" items)
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig   # then paste the keys in by hand
//
// Included from Config/Debug.xcconfig (Debug only). Each setting reaches a Debug app through
// Config/BusBus-Info.plist (the BusBusAPIKeys dictionary, Debug only). An empty key makes its
// provider unavailable, never a crash.
// Values are unquoted; a value may not contain "//" (xcconfig treats it as a comment).
//
// To add a key: add NAME = here, NAME/$(NAME) to BusBus-Info.plist, and its Keychain id to
// scripts/api-keys.sh if the name is not the id upper-cased with "_KEY" appended.

// MTA Bus Time (New York City) — free key from https://register.developer.obanyc.com/
// Keychain: security add-generic-password -a busbus -s "BusBus API key: mta-bustime-nyc" -w <key>
MTA_BUSTIME_KEY =

// OneBusAway Puget Sound (Seattle) — free key by e-mail to oba_api_key@soundtransit.org
// Keychain: security add-generic-password -a busbus -s "BusBus API key: oba-pugetsound" -w <key>
OBA_PUGETSOUND_KEY =

// OneBusAway Tampa (HART) — key by e-mail to info@onebusaway.org (Open Transit Software Foundation)
// Keychain: security add-generic-password -a busbus -s "BusBus API key: oba-tampa" -w <key>
OBA_TAMPA_KEY =

// mobiliteit.lu (Luxembourg) — accessId by e-mail to opendata-api@atp.etat.lu
// Keychain: security add-generic-password -a busbus -s "BusBus API key: mobiliteit-lu" -w <key>
MOBILITEIT_LU_KEY =

// VBB (Berlin-Brandenburg) — accessId by e-mail to api@vbb.de (test, then production via their form)
// Keychain: security add-generic-password -a busbus -s "BusBus API key: vbb" -w <key>
VBB_KEY =
