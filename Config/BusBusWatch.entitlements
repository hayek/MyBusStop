<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The watch's own container, shared by its app and complications (AppGroup.swift); filled
	     by WatchSyncReceiver with what the phone sends. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hayek.BusBus</string>
	</array>
</dict>
</plist>
