<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The watch app's half of its Info.plist; WKApplication and the companion's id are build
	     settings. No API keys, ever: the watch calls only keyless feeds. -->
	<!-- busbus://setup?id=… opens a saved stop's board: where a complication sends a tap (WidgetDeepLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hayek.BusBus.watchkitapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>busbus</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
